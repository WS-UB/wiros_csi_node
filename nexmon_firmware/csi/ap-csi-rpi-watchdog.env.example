# Copy to /etc/default/ap-csi-rpi-watchdog on the RPi paired with the router
# assigned the AP+CSI role.
AP_CSI_ROUTER_HOST=192.168.48.6
AP_CSI_SOURCE_IP=192.168.48.20
AP_CSI_LINK_INTERFACE=eth0
AP_CSI_ROUTER_USER=wiloc
AP_CSI_ROUTER_LABEL=router-1
AP_CSI_PASSWORD_FILE=/home/wiloc/.config/wiros/ap_csi_router_password
AP_CSI_KNOWN_HOSTS=/home/wiloc/.ssh/ap_csi_router_known_hosts
AP_CSI_REMOTE_COMMAND=/jffs/csi/ap-csi-autostart.sh
AP_CSI_BOOT_SETTLE=120
AP_CSI_HEALTH_INTERVAL=60
AP_CSI_RETRY_DELAY=20
AP_CSI_COMMAND_TIMEOUT=180
AP_CSI_MAX_FAILURES=3
