# Copy to /jffs/csi/ap-csi.env on the router assigned the AP+CSI role.
AP_CSI_MODULE_PATH=/lib/modules/4.1.27/extra/dhd.ko
AP_CSI_CANDIDATE=/jffs/csi/dhd-ap-concurrent.ko
AP_CSI_STOCK_BACKUP=/jffs/csi/dhd-stock-original-ac4f5be9.ko
AP_CSI_EXPECTED_CANDIDATE_MD5=1e37e15766204e56924c277c3382a954
AP_CSI_EXPECTED_STOCK_MD5=ac4f5be9e63816e1eea59490853c1b6b
AP_CSI_INTERFACE=eth6
AP_CSI_BRIDGE=br0
AP_CSI_BRIDGE_INTERFACES="eth6 eth5"
AP_CSI_BRCTL=brctl
AP_CSI_SSID=WIRES-AP
AP_CSI_NVRAM_PREFIX=wl1
AP_CSI_DISABLED_INTERFACES=eth5
AP_CSI_DISABLED_NVRAM_PREFIXES=wl0
AP_CSI_CHANNEL=36
AP_CSI_BANDWIDTH_MHZ=80
AP_CSI_TX_STREAMS=4
AP_CSI_RX_CORES=4
AP_CSI_TARGET_MAC=a6:aa:40:58:22:bd
AP_CSI_MIN_INTERVAL_MS=1
AP_CSI_QUIESCE_INTERVAL_SECONDS=2
# Router management daemons that issue competing DHD control requests. Core AP
# authentication, DHCP, bridging, and routing services are intentionally absent.
AP_CSI_QUIESCE_PROCESSES="dhd_monitor roamast wlc_nt networkmap wps_monitor wpsaide wlceventd watchdog bwdpi_check cfg_server mastiff"
