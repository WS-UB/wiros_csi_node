+uint16
+bcm4366_first_enabled(uint16 mask)
+{
+    uint16 candidate;
+    for (candidate = 0; candidate < BCM4366_NSS_PER_CORE; candidate++) {
+        if (mask & (1 << candidate)) {
+            return candidate;
+        }
+    }
+    return BCM4366_NSS_PER_CORE;
+}
+
+uint16
+bcm4366_next_enabled(uint16 mask, uint16 current)
+{
+    uint16 step;
+    for (step = 1; step <= BCM4366_NSS_PER_CORE; step++) {
+        uint16 candidate = (current + step) & (BCM4366_NSS_PER_CORE - 1);
+        if (mask & (1 << candidate)) {
+            return candidate;
+        }
+    }
+    return current;
+}
+
+int
+bcm4366_advance_stream(void)
+{
+    uint16 first_core = bcm4366_first_enabled(csi_stream_coremask);
+    uint16 first_nss = bcm4366_first_enabled(csi_stream_nssmask);
+    uint16 next_core = bcm4366_next_enabled(
+        csi_stream_coremask, csi_stream_core
+    );
+
+    csi_stream_core = next_core;
+    if (next_core != first_core) {
+        return 0;
+    }
+
+    csi_stream_nss = bcm4366_next_enabled(
+        csi_stream_nssmask, csi_stream_nss
+    );
+    return csi_stream_nss == first_nss;
+}
