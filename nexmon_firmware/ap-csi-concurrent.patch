+/*
+ * Each receive core has one channel-estimate table.  Its four spatial
+ * streams occupy contiguous 256-entry regions.  Read a core's table once
+ * into an aligned scratch buffer, then split it into the 16 wire-format
+ * packets expected by the collector.  Besides reducing table setup/teardown
+ * operations from 16 to 4 per matrix, this keeps the PHY reader from writing
+ * directly into dynamically allocated packet buffers.
+ */
+#define BCM4366_TONES_PER_NSS           256
+#define BCM4366_NSS_PER_CORE            4
+uint32 csi_core_values[BCM4366_TONES_PER_NSS * BCM4366_NSS_PER_CORE]
+    __attribute__((aligned(4))) = { 1 };
+
+typedef void (*bcm4366_phy_table_read_fn)(void *pi, unsigned int id,
+    unsigned int len, unsigned int offset, unsigned int width, void *data);
+
+void
+bcm4366_wlc_phy_table_read_acphy(void *pi, unsigned int id, unsigned int len,
+                                 unsigned int offset, unsigned int width,
+                                 void *data)
+{
+    ((bcm4366_phy_table_read_fn) BCM4366_WLC_PHY_TABLE_READ_ACPHY_ADDR)(
+        pi, id, len, offset, width, data
+    );
+}
+
+uint16
+bcm4366_tones_for_rxchan(uint16 rxchan)
+{
+    switch ((rxchan & 0x3800) >> 11) {
+        case 4: return 256;
+        case 3: return 128;
+        default: return 64;
+    }
+}
+
+void
+process_bcm4366_ready_csi(struct wlc_hw_info *wlc_hw, uint32 tsf_l)
+{
+    uint16 ready = wlc_bmac_read_shm(
+        wlc_hw, BCM4366_SHM_CSI_READY * 2
+    );
+    if (ready == csi_last_ready) {
+        return;
+    }
+
+    csi_last_ready = ready;
+    csi_diagnostic_ready++;
+
+    /*
+     * Reading the channel-estimate tables in the receive hook is expensive
+     * enough to starve the AP control path during a burst.  The ioctl's delay
+     * field is interpreted as milliseconds for this AP-concurrent BCM4366
+     * implementation.  Advance csi_last_ready even when a sample is dropped
+     * so a burst cannot be replayed later as stale CSI.
+     */
+    uint32 min_interval_us = (uint32) wlc_bmac_read_shm(
+        wlc_hw, BCM4366_SHM_MIN_INTERVAL_MS * 2
+    ) * 1000;
+    if (min_interval_us != 0 && csi_last_extract_tsf != 0 &&
+        (uint32) (tsf_l - csi_last_extract_tsf) < min_interval_us) {
+        csi_diagnostic_rate_limited++;
+        return;
+    }
+    csi_last_extract_tsf = tsf_l;
+
+    uint16 src[3];
+    src[0] = wlc_bmac_read_shm(wlc_hw, BCM4366_SHM_CSI_SRC_0 * 2);
+    src[1] = wlc_bmac_read_shm(wlc_hw, BCM4366_SHM_CSI_SRC_1 * 2);
+    src[2] = wlc_bmac_read_shm(wlc_hw, BCM4366_SHM_CSI_SRC_2 * 2);
+    uint16 seq = wlc_bmac_read_shm(wlc_hw, BCM4366_SHM_CSI_SEQ * 2);
+    uint16 rxchan = wlc_bmac_read_shm(
+        wlc_hw, BCM4366_SHM_CSI_RXCHAN * 2
+    );
+    uint16 coremask = wlc_bmac_read_shm(
+        wlc_hw, BCM4366_SHM_COREMASK * 2
+    );
+    uint16 nssmask = wlc_bmac_read_shm(
+        wlc_hw, BCM4366_SHM_NSSMASK * 2
+    );
+    uint16 tones = bcm4366_tones_for_rxchan(rxchan);
+    struct wl_info *wl = wlc_hw->wlc->wl;
+
+    int core;
+    int nss;
+    for (core = 0; core < 4; core++) {
+        if ((coremask & (1 << core)) == 0) {
+            continue;
+        }
+        uint16 table_id = 73 + 32 * core;
+
+        /* Stop at the highest requested stream, while retaining the fixed
+         * 256-entry stride between spatial streams at narrower bandwidths. */
+        int highest_nss = -1;
+        for (nss = BCM4366_NSS_PER_CORE - 1; nss >= 0; nss--) {
+            if (nssmask & (1 << nss)) {
+                highest_nss = nss;
+                break;
+            }
+        }
+        if (highest_nss < 0) {
+            continue;
+        }
+
+        unsigned int table_span = highest_nss * BCM4366_TONES_PER_NSS +
+                                  tones;
+        bcm4366_wlc_phy_table_read_acphy(
+            wlc_hw->band->pi, table_id, table_span, 0, 32,
+            csi_core_values
+        );
+        csi_diagnostic_table_reads++;
+
+        for (nss = 0; nss < 4; nss++) {
+            if ((nssmask & (1 << nss)) == 0) {
+                continue;
+            }
+
+            create_new_csi_frame(wl, ((nss << 3) | core) << 8,
+                                 tones * sizeof(uint32));
+            if (p_csi == 0) {
+                csi_diagnostic_alloc_failures++;
+                continue;
+            }
+
+            struct csi_udp_frame *udpfrm =
+                (struct csi_udp_frame *) p_csi->data;
+            memcpy(udpfrm->SrcMac, src, sizeof(udpfrm->SrcMac));
+            udpfrm->seqCnt = seq;
+            udpfrm->csiconf = ((nss << 3) | core) << 8;
+            udpfrm->chanspec = rxchan;
+
+            memcpy(
+                udpfrm->csi_values,
+                &csi_core_values[nss * BCM4366_TONES_PER_NSS],
+                tones * sizeof(uint32)
+            );
+
+            uint8 offset = (((rxchan & 0x3800) >> 11) == 2) ? 28 : 0;
+            memcpy(&udpfrm->csi_values[offset], phystatus, sizeof(phystatus));
+
+            p_csi->len = sizeof(struct csi_udp_frame) +
+                         tones * sizeof(uint32);
+            skb_pull(p_csi, sizeof(struct ethernet_ip_udp_header));
+            prepend_ethernet_ipv4_udp_header(p_csi);
+            int xmit_ret = wl->dev->chained->funcs->xmit(
+                wl->dev, wl->dev->chained, p_csi
+            );
+            if (xmit_ret != 0) {
+                csi_diagnostic_xmit_failures++;
+            }
+            p_csi = 0;
+            csi_diagnostic_packets++;
+        }
+    }
+}
