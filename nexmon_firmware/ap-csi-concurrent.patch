+    return (bandwidth == 2 || bandwidth == 3 || bandwidth == 4) &&
+           (frame->csiconf & 0xff) == 0 &&
+           core < 4 && nss < 4 &&
+           (frame->start & 0x7fff) == chunks &&
+           missing >= 1 && missing <= chunks;
