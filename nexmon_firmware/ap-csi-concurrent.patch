diff --git a/Makefile b/Makefile
index bdc60ab..3fdf29a 100644
--- a/Makefile
+++ b/Makefile
@@ -210,7 +210,15 @@ gen/ucode.asm: $(FW_PATH)/ucode.bin
 endif
 	@printf "\033[0;31m  DISASSEMBLING UCODE\033[0m %s => %s\n" $< $@
 	$(Q)$(NEXMON_ROOT)/buildtools/$(B43VERSION)/disassembler/b43-dasm $< $@ --arch 15 --format raw-le32 2>log/disass.log
+
+# The BCM4366 CSI patch is maintained against the deterministic raw
+# disassembly. Beautifying it replaces register operands with aliases whose
+# output varies with the installed b43 definition files and makes patch
+# application silently reject hunks (the historical rule ignores patch's
+# status). Other targets retain their existing beautified source.
+ifeq ($(findstring bcm4366c0,$(FWUCODE)), )
 	$(Q)$(NEXMON_ROOT)/buildtools/$(B43VERSION)/debug/b43-beautifier --asmfile $@ --defs $(NEXMON_ROOT)/buildtools/$(B43VERSION)/debug/include > tmp && mv tmp $@
+endif
 
 src/$(UCODEFILE:.patch=.asm): src/$(UCODEFILE) gen/ucode.asm
 	@printf "\033[0;31m  PATCHING UCODE\033[0m %s => %s\n" $< $@
